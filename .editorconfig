# Editor settings for every file, and the Kotlin code style: ktlint reads its settings from here, in the Gradle build
# (Spotless) and the editors' save hooks, so they all format alike. The rules are the Gefera app's.
# https://editorconfig.org, https://pinterest.github.io/ktlint/latest/rules/configuration-ktlint/
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# A line ending in two spaces is a line break.
trim_trailing_whitespace = false
max_line_length = off

# The IDE writes its settings without a final newline.
[.idea/**]
insert_final_newline = unset

[*.{kt,kts}]
# IntelliJ's Kotlin coding conventions (kotlin.code.style=official), so the IDE's formatter agrees with ktlint.
ktlint_code_style = intellij_idea
ij_kotlin_code_style_defaults = KOTLIN_OFFICIAL
max_line_length = 140
# The IDE never writes a wildcard import, which ktlint reports and can't fix.
ij_kotlin_name_count_to_use_star_import = 2147483647
ij_kotlin_name_count_to_use_star_import_for_members = 2147483647
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# A function's or a class's parameters, five or more, go one to a line; fewer go on one line when they fit.
ktlint_function_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than = 5
ktlint_class_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than = 5
# The package is com.eerie_leap.mdf, which this rule refuses for the underscore; detekt's PackageNaming checks it instead.
ktlint_standard_package-name = disabled
